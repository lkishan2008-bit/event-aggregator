# Copy this file to .env and fill in real values. Never commit .env.

# Leave DATABASE_URL empty to use a local SQLite file (easiest for development).
# For Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=

# Generate random secrets with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Frontend URL allowed to call the API (comma-separated for several)
CORS_ORIGINS=http://localhost:3000