# Copy this file to .env and fill in real values. Never commit .env.

# Leave DATABASE_URL empty to use a local SQLite file (easiest for development).
# For Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=

# Generate random secrets with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Frontend URL allowed to call the API (comma-separated for several)
CORS_ORIGINS=http://localhost:3000

# Amazon SES for OTP emails. Leave SES_SENDER empty to print codes in the terminal (development).
SES_SENDER=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Razorpay paid tickets (Dashboard -> Account & Settings -> API Keys, use TEST mode keys).
# Leave both empty to use a fake "test payment" screen for demos.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Auto-import of calendar feeds: how often (minutes, 0 = off) and a secret for an external cron to call
# POST /api/cron/sync-feeds with header X-Cron-Secret. Generate with: python -c "import secrets; print(secrets.token_hex(16))"
FEED_SYNC_MINUTES=60
CRON_SECRET=